{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm exec --yes --package=npm@12.0.2 -- npm ci --include=dev --ignore-scripts --strict-peer-deps --engine-strict",
  "buildCommand": "npm exec --yes --package=npm@12.0.2 -- npm run docs:build:verified",
  "outputDirectory": ".build-artifacts/verified-docs/dist"
}
